<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cozy"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="36dp"
    android:paddingEnd="36dp"
    android:paddingBottom="36dp">

    <!-- Status Title -->
    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Sua planta\nfloresceu!"
        android:textColor="@color/text_terracotta"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Plant Image (Bloomed or Wilted) -->
    <ImageView
        android:id="@+id/ivResultPlant"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Resultado da planta"
        android:src="@drawable/broto_4" />

    <!-- Final Stats -->
    <TextView
        android:id="@+id/tvFinalGrowth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crescimento final: 100%"
        android:textColor="@color/text_terracotta"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFinalDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="44dp"
        android:text="Dias usados: 6"
        android:textColor="@color/text_terracotta"
        android:textSize="16sp" />

    <!-- Play Again Button -->
    <Button
        android:id="@+id/btnPlantarDeNovo"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:background="@drawable/btn_encerrar_bg"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:letterSpacing="0.04"
        android:stateListAnimator="@null"
        android:text="PLANTAR DE NOVO"
        android:textColor="@color/text_terracotta"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
