<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Cores pedidas pelo usuário -->
    <!-- creme #FFF6E5 (fundo do jogo) -->
    <color name="bg_cozy">#FFF6E5</color>
    <!-- terracota #D98C5F (textos e contorno do botão encerrar dia) -->
    <color name="text_terracotta">#D98C5F</color>
    <color name="text_brown_dark">#D98C5F</color>
    <color name="text_muted">#C9A68F</color>

    <!-- Fundo dos botões (igual ao fundo do jogo) -->
    <color name="btn_bg">@color/bg_cozy</color>

    <!-- Contornos específicos de cada ação -->
    <!-- Sol: border_sun / btn_sol_border -->
    <color name="border_sun">#F4C95D</color>
    <color name="btn_sol_border">@color/border_sun</color>

    <!-- Regar / Água: border_water / btn_regar_border -->
    <color name="border_water">#7CC6E0</color>
    <color name="btn_regar_border">@color/border_water</color>

    <!-- Adubar: border_adubar / btn_adubar_border -->
    <color name="border_adubar">#8DB580</color>
    <color name="btn_adubar_border">@color/border_adubar</color>

    <!-- Encerrar dia: mesma cor dos textos do jogo (#D98C5F) -->
    <color name="btn_encerrar_border">@color/text_terracotta</color>

    <!-- Progress Bar -->
    <color name="progress_bg">#EED8C1</color>
    <color name="progress_fill">#8DB580</color>

    <!-- Icons / Accents -->
    <color name="color_sun">#F4C95D</color>
    <color name="color_heart">#E75A70</color>
    <color name="color_water">#7CC6E0</color>
    <color name="card_bg">#FFF0D6</color>
</resources>